    name: "\u6FC0\u7D20\u670B\u514B "
    description: "\u8BB0\u5F55\u7740\u300A\u6FC0\u7D20\u670B\u514B\u300B\u66F2\u76EE\u7684\u9A71\u52A8\u76D8\uFF0C\u968F\u7740\u97F3\u64CE\u65CB\u8F6C\u800C\u6D0B\u6EA2\u51FA\u7684\u65CB\u5F8B\uFF0C\u662F\u9F13\u566A\u4EA2\u594B\u7684\u8C03\u6027\u3002 "
    skillDescription: "\u8FDB\u5165\u63A5\u6218\u72B6\u6001\u6216\u6362\u5165\u524D\u573A\u65F6\uFF0C\u88C5\u5907\u8005\u7684\u653B\u51FB\u529B\u63D0\u534725%\uFF0C\u6301\u7EED10\u79D2\uFF0C20\u79D2\u5185\u6700\u591A\u89E6\u53D1\u4E00\u6B21\u3002 "
    imagePath: "UI/Package/IconImage/DriverDisk/\u6FC0\u7D20\u670B\u514B"
  - id: 1
    type: 0
    star: 5
    name: "\u7360\u7259\u91CD\u91D1\u5C5E "
    description: "\u8BB0\u5F55\u7740\u300A\u7360\u7259\u91CD\u91D1\u5C5E\u300B\u66F2\u76EE\u7684\u9A71\u52A8\u76D8\uFF0C\u968F\u7740\u97F3\u64CE\u65CB\u8F6C\u800C\u6D0B\u6EA2\u51FA\u7684\u65CB\u5F8B\uFF0C\u662F\u72C2\u50B2\u96BE\u9A6F\u7684\u8C03\u6027\u3002 "
    skillDescription: "\u961F\u4F0D\u4E2D\u4EFB\u610F\u89D2\u8272\u5BF9\u654C\u4EBA\u65BD\u52A0[\u5F3A\u51FB]\u6548\u679C\u65F6\uFF0C\u88C5\u5907\u8005\u5BF9\u76EE\u6807\u9020\u6210\u7684\u4F24\u5BB3\u63D0\u534735%\uFF0C\u6301\u7EED12\u79D2\u3002 "
    imagePath: "UI/Package/IconImage/DriverDisk/\u7360\u7259\u91CD\u91D1\u5C5E"
  - id: 2
    type: 1
    star: 5
    name: "\u70BC\u72F1\u9F7F\u8F6E "
    description: "\u8D85\u5927\u529F\u7387\u7684\u529F\u80FD\u97F3\u64CE\uFF0C\u7ECF\u8FC7\u6539\u88C5\uFF0C\u5176\u80FD\u6548\u6C34\u5E73\u51E0\u4E4E\u8D85\u8D8A\u4E86\u5B89\u5168\u4E0A\u9650\u3002 "
    skillDescription: "S\u7EA7\u51FB\u7834\u578B\u97F3\u64CE\uFF0C\u88C5\u5907\u8BE5\u97F3\u64CE\u540E\u53EF\u5728\u540E\u573A\u56DE\u590D\u80FD\u91CF\u540E\u4E0A\u573A\u91CA\u653E\u5F3A\u5316\u7279\u6B8A\u6280\u3001\u914D\u5408\u6838\u5FC3\u88AB\u52A8\u8FDB\u884C\u5927\u91CF\u5931\u8861\u503C\u8F93\u51FA "
    imagePath: "UI/Package/IconImage/Engine/\u70BC\u72F1\u9F7F\u8F6E"
  - id: 3
    type: 1
    star: 5
    name: "\u94A2\u94C1\u8089\u57AB "
    description: "\u589E\u5F3A\u4E86\u52A8\u4F5C\u76D1\u6D4B\u529F\u80FD\u7684\u8D85\u7B97\u97F3\u64CE\uFF0C\u80FD\u591F\u5B8C\u7F8E\u914D\u5408\u795E\u7ECF\u53CD\u5C04\u901F\u5EA6\u548C\u7279\u6B8A\u683C\u6597\u52A8\u4F5C\u3002 "
    skillDescription: "S\u7EA7\u5F3A\u653B\u578B\u97F3\u64CE\uFF0C\u53EF\u589E\u52A0\u88C5\u5907\u8005\u7269\u7406\u4F24\u5BB3\u4EE5\u53CA\u4ECE\u80CC\u540E\u653B\u51FB\u654C\u4EBA\u6240\u9020\u6210\u7684\u4F24\u5BB3\u3002 "
    imagePath: "UI/Package/IconImage/Engine/\u94A2\u94C1\u8089\u57AB"
  - id: 4
    type: 2
    star: 4
    name: "\u6076\u9B54\u5E03 "
    description: "\u6BD4\u6076\u9B54\u66F4\u80FD\u86CA\u60D1\u4EBA\u7C7B\u7684\u2026\u53EA\u6709\u6076\u9B54\u90A6\u5E03\uFF01 "
    skillDescription: "\u62DB\u5F0F\u53D1\u52A8\u65F6\uFF0C\u8FDB\u5165\u98DE\u884C\u72B6\u6001\uFF0C\u6301\u7EED\u5BF9\u654C\u4EBA\u53D1\u5C04\u8FFD\u8E2A\u5B50\u5F39\uFF0C\u9020\u6210\u4EE5\u592A\u4F24\u5BB3\u5E76\u7D2F\u79EF\u4EE5\u592A\u5F02\u5E38\u79EF\u84C4\u503C\u3002 "
    imagePath: "UI/Package/IconImage/Bangboo/\u6076\u9B54\u5E03"
